   APP_NAME="Buscador Semántico BOE"
   APP_ENV=local
   APP_KEY=
   APP_DEBUG=true
   APP_URL=http://localhost:8000

   LOG_CHANNEL=stack
   LOG_LEVEL=debug

   CACHE_STORE=file
   SESSION_DRIVER=file
   QUEUE_CONNECTION=sync

   BOE_DATA_STORE=json
   BOE_JSON_INDEX_PATH=app/boe/chunks.json
   BOE_FIXTURE_PATH=app/fixtures/boe-sample.json

   # Optional MongoDB storage
   BOE_MONGODB_URI=mongodb://mongo:27017
   BOE_MONGODB_DATABASE=boe_search
   BOE_MONGODB_COLLECTION=chunks

   # Local embedding service
   BOE_EMBEDDING_SERVICE_URL=http://embeddings:8000
   BOE_EMBEDDING_ALLOW_HASH_FALLBACK=true
